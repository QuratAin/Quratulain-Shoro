          <path fill-rule="evenodd" clip-rule="evenodd" d="M24.8478 0V7.31804L23.8799 8.28259H16.5652V49.6955H8.28259V8.28259H0V0.967838L0.967834 0H24.8478Z" fill="currentColor"/>
        </svg>
      {%- endif -%}
    </a>

    {%- if section.settings.top_bar_text != blank -%}
      <p class="gift-banner__topbar-text">{{ section.settings.top_bar_text }}</p>
    {%- endif -%}

    {%- if section.settings.choose_gift_label != blank -%}
      <a
        {% if section.settings.choose_gift_link != blank %}
          href="{{ section.settings.choose_gift_link }}"
        {% else %}
          href="#" role="link" aria-disabled="true"
        {% endif %}
        class="gift-banner__btn gift-banner__btn--choose"
      >
        <span class="gift-banner__btn-fill" aria-hidden="true"></span>
        <span class="gift-banner__btn-label">
          {{ section.settings.choose_gift_label }}
          <svg viewBox="0 0 68 30" fill="none" aria-hidden="true" class="gift-banner__arrow">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="currentColor"/>
          </svg>
        </span>
      </a>
    {%- endif -%}
  </div>

  <div class="gift-banner__main">
    {%- if section.settings.background_image -%}
      {%- liquid
        assign mobile_image = section.settings.mobile_background_image | default: section.settings.background_image
      -%}
      <div class="gift-banner__hero-row">
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 400 }} 400w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
          <img
            srcset="
              {%- if section.settings.background_image.width >= 375 -%}{{ section.settings.background_image | image_url: width: 375 }} 375w,{%- endif -%}
              {%- if section.settings.background_image.width >= 750 -%}{{ section.settings.background_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if section.settings.background_image.width >= 1100 -%}{{ section.settings.background_image | image_url: width: 1100 }} 1100w,{%- endif -%}
              {%- if section.settings.background_image.width >= 1500 -%}{{ section.settings.background_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {%- if section.settings.background_image.width >= 1780 -%}{{ section.settings.background_image | image_url: width: 1780 }} 1780w,{%- endif -%}
              {{ section.settings.background_image | image_url: width: 2200 }} 2200w
            "
            src="{{ section.settings.background_image | image_url: width: 1780 }}"
            sizes="100vw"
            alt=""
            loading="lazy"
            width="{{ section.settings.background_image.width }}"
            height="{{ section.settings.background_image.height }}"
            class="gift-banner__image"
          >
        </picture>
      </div>
    {%- endif -%}

    <div class="gift-banner__content-row">
      <div class="gift-banner__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="gift-banner__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.mobile_description != blank -%}
          <div class="gift-banner__description gift-banner__description--mobile">{{ section.settings.mobile_description }}</div>
        {%- elsif section.settings.description != blank -%}
          <div class="gift-banner__description gift-banner__description--mobile">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="gift-banner__description gift-banner__description--desktop">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.shop_now_label != blank -%}
          <a
            {% if section.settings.shop_now_link != blank %}
              href="{{ section.settings.shop_now_link }}"
            {% else %}
              href="#" role="link" aria-disabled="true"
            {% endif %}
            class="gift-banner__btn gift-banner__btn--shop"
          >
            <span class="gift-banner__btn-fill" aria-hidden="true"></span>
            <span class="gift-banner__btn-label">
              {{ section.settings.shop_now_label }}
              <svg viewBox="0 0 68 30" fill="none" aria-hidden="true" class="gift-banner__arrow">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="currentColor"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.background_image -%}
        <div class="gift-banner__feature-image">
          <picture>
            <img
              src="{{ section.settings.background_image | image_url: width: 1780 }}"
              srcset="
                {%- if section.settings.background_image.width >= 375 -%}{{ section.settings.background_image | image_url: width: 375 }} 375w,{%- endif -%}
                {%- if section.settings.background_image.width >= 750 -%}{{ section.settings.background_image | image_url: width: 750 }} 750w,{%- endif -%}
                {%- if section.settings.background_image.width >= 1100 -%}{{ section.settings.background_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                {%- if section.settings.background_image.width >= 1500 -%}{{ section.settings.background_image | image_url: width: 1500 }} 1500w,{%- endif -%}
                {%- if section.settings.background_image.width >= 1780 -%}{{ section.settings.background_image | image_url: width: 1780 }} 1780w,{%- endif -%}
                {{ section.settings.background_image | image_url: width: 2200 }} 2200w
              "
              sizes="100vw"
              alt=""
              loading="lazy"
              width="{{ section.settings.background_image.width }}"
              height="{{ section.settings.background_image.height }}"
              class="gift-banner__image"
            >
          </picture>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.bottom_bar_text != blank -%}
    <div class="gift-banner__bottombar">
      <p>{{ section.settings.bottom_bar_text }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "The Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "TISSO VISON"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo image",
      "info": "Leave empty to use the default TISSO VISON wordmark"
    },
    {
      "type": "text",
      "id": "top_bar_text",
      "label": "Top bar message",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "range",
      "id": "top_bar_font_size",
      "label": "Top bar text size (desktop)",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "top_bar_font_size_mobile",
      "label": "Top bar text size (mobile)",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "text",
      "id": "choose_gift_label",
      "label": "Button label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "choose_gift_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "choose_gift_font_size",
      "label": "Button text size (desktop)",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "choose_gift_font_size_mobile",
      "label": "Button text size (mobile)",
      "min": 10,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Main content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background illustration (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_background_image",
      "label": "Background illustration (mobile)",
      "info": "Leave empty to reuse the desktop image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 32,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (desktop)",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_description",

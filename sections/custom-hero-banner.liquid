{{ 'component-custom-hero-banner.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500&display=swap" rel="stylesheet">

{%- style -%}
  /* Theme variables and responsive sizing for the gift banner */
  #GiftBanner-{{ section.id }} {
    --gb-topbar-bg: {{ section.settings.top_bar_bg }};
    --gb-bottombar-bg: {{ section.settings.bottom_bar_bg }};
    --gb-bg: {{ section.settings.background_color }};
    --gb-heading-color: {{ section.settings.heading_color }};
    --gb-text-color: {{ section.settings.description_color }};
    --gb-topbar-text-color: {{ section.settings.top_bar_text_color }};
    --gb-bottombar-text-color: {{ section.settings.bottom_bar_text_color }};

    --gb-choose-bg: {{ section.settings.choose_gift_bg }};
    --gb-choose-text: {{ section.settings.choose_gift_text }};
    --gb-choose-hover-bg: {{ section.settings.choose_gift_hover_bg }};
    --gb-choose-hover-text: {{ section.settings.choose_gift_hover_text }};

    --gb-shop-bg: {{ section.settings.shop_now_bg }};
    --gb-shop-text: {{ section.settings.shop_now_text }};
    --gb-shop-hover-bg: {{ section.settings.shop_now_hover_bg }};
    --gb-shop-hover-text: {{ section.settings.shop_now_hover_text }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__topbar-text {
    font-size: {{ section.settings.top_bar_font_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__bottombar p {
    font-size: {{ section.settings.bottom_bar_font_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__description {
    font-size: {{ section.settings.description_font_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__btn--choose {
    font-size: {{ section.settings.choose_gift_font_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__btn--shop {
    font-size: {{ section.settings.shop_now_font_size_mobile }}px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__content {
    max-width: 100%;
    padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    #GiftBanner-{{ section.id }} .gift-banner__topbar-text {
      font-size: {{ section.settings.top_bar_font_size }}px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__bottombar p {
      font-size: {{ section.settings.bottom_bar_font_size }}px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__heading {
      font-size: {{ section.settings.heading_size_desktop }}px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__description {
      font-size: {{ section.settings.description_font_size }}px;
      max-width: {{ section.settings.content_max_width }}px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__btn--choose {
      font-size: {{ section.settings.choose_gift_font_size }}px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__btn--shop {
      font-size: {{ section.settings.shop_now_font_size }}px;
      position: static;
      transform: none;
    }

    #GiftBanner-{{ section.id }} .gift-banner__main {
      min-height: 640px;
      display: block;
    }

    #GiftBanner-{{ section.id }} .gift-banner__content {
      position: relative;
      z-index: 1;
      text-align: left;
      max-width: {{ section.settings.content_max_width }}px;
      padding: {{ section.settings.content_padding_top }}px {{ section.settings.content_padding_left }}px {{ section.settings.content_padding_bottom }}px;
    }
  }
{%- endstyle -%}

<!-- Gift banner main wrapper: top strip, hero media, and copy block -->
<div class="gift-banner color-{{ section.settings.color_scheme }}" id="GiftBanner-{{ section.id }}">
  <div class="gift-banner__topbar">
    <button
      type="button"
      class="gift-banner__hamburger"
      aria-label="{{ 'general.menu' | t: default: 'Menu' }}"
      aria-controls="GiftBannerMobileMenu-{{ section.id }}"
      aria-expanded="false"
    >
      <svg width="20" height="12" viewBox="0 0 20 12" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 6H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M1 1H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M1 11H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <a href="{{ routes.root_url }}" class="gift-banner__logo" aria-label="{{ section.settings.logo_text | default: shop.name }}">
      {%- if section.settings.logo_image -%}
        <img
          src="{{ section.settings.logo_image | image_url: width: 400 }}"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
          alt="{{ section.settings.logo_image.alt | default: section.settings.logo_text }}"
          loading="eager"
        >
      {%- else -%}
        <svg viewBox="0 0 404 51" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M363.402 0.000305176L395.565 32.1628V1.93269L396.532 0.964852H402.883L403.85 1.93269V50.6604H402.33L370.72 19.0509V49.6958L369.752 50.6604H363.402L362.438 49.6958V0.964852L363.402 0.000305176Z" fill="currentColor"/>

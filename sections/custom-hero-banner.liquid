                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9.31791 0V2.74427L8.95497 3.10597H6.21194V18.6358H3.10597V3.10597H0V0.362939L0.362938 0H9.31791Z" fill="black"/>
                </svg>
            {% endif %}
        </a>

        {% if section.settings.top_bar_text %}
            <p class="gift-banner__topbar-text">{{ section.settings.top_bar_text }}</p>
        {% endif %}

        {% if section.settings.choose_gift_label %}
            <a 
                {% if section.settings.choose_gift_link %}
                    href="{{ section.settings.choose_gift_link }}"
                {% else %}
                    href="{{ shop.url }}/collections/all"
                {% endif %}
                class="gift-banner__btn gift-banner__btn--choose" 
                aria-label="Choose Gift"
            >
                <span class="gift-banner__btn--fill" aria-hidden="true"></span>
                <span class="gift-banner__btn-label">
                    {{ section.settings.choose_gift_label }}
                    <svg class="gift-banner__arrow" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
                    </svg>
                </span>
            </a>
        {% endif %}
    </div>

    {% comment %} main {% endcomment %}
    <div class="gift-banner__main">
        {% comment %} background image {% endcomment %}
        <img src="{{ section.settings.background_image | asset_url }}" alt="Hero Banner Background" class="gift-banner__background-image">

        {% comment %} main content {% endcomment %}
        <div class="gift-banner__content">
            {% if section.settings.heading %}
                <h2 class="gift-banner__heading">{{ section.settings.heading }}</h2>
            {% endif %}

            {% if section.settings.mobile_description %}
                <div class="gift-banner__description gift-banner__description--mobile">
                    {{ section.settings.mobile_description }}
                </div>
            {% elsif section.settings.description %}
                <div class="gift-banner__description gift-banner__description--mobile">
                    {{ section.settings.description }}
                </div>
            {% endif %}

            {% if section.settings.description %}
                <div class="gift-banner__description gift-banner__description--desktop">
                    {{ section.settings.description }}
                </div>
            {% endif %}

            {% if section.settings.shop_now_label %}

            <a href="{{ section.settings.shop_now_link }}" class="gift-banner__btn gift-banner__btn--shop" aria-label="{{ section.settings.shop_now_label }}">
                <span class="gift-banner__btn--fill" aria-hidden="true"></span>
                <span class="gift-banner__btn-label">{{ section.settings.shop_now_label }}
                    <svg class="gift-banner__arrow" viewBox="0 0 26 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 4.77298L7.37629e-08 4.77298L-7.37629e-08 6.27298L0.75 6.27298L0.75 4.77298ZM25.2803 6.05331C25.5732 5.76042 25.5732 5.28554 25.2803 4.99265L20.5074 0.21968C20.2145 -0.073213 19.7396 -0.0732131 19.4467 0.21968C19.1538 0.512574 19.1538 0.987447 19.4467 1.28034L23.6893 5.52298L19.4467 9.76562C19.1538 10.0585 19.1538 10.5334 19.4467 10.8263C19.7396 11.1192 20.2145 11.1192 20.5074 10.8263L25.2803 6.05331ZM0.75 6.27298L24.75 6.27298L24.75 4.77298L0.75 4.77298L0.75 6.27298Z" fill="black"/>
                    </svg>
                </span>
            </a>
        </div>
    </div>

    {% comment %} bottom bar {% endcomment %}
    <div class="gift-banner__bottombar">
        <p class="gift-banner__bottombar-text">{{ section.settings.bottom_bar_text }}</p>
    </div>
</div>

{% schema %}
  {
    "name": "Hero Banner",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "header",
            "content": "Top Bar"
        },
        {
            "type": "text",
            "id": "logo_text",
            "label": "Logo text",
            "default": "Tisso Vision"
        },
        {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo image",
            "info": "Upload a logo image to display in the top bar. Leave empty to use the logo text instead."
        },
        {
            "type": "text",
            "id": "top_bar_text",
            "label": "Top bar message",
            "default": "Find the ideal gift for your loved ones"
        },
        {
            "type": "text",
            "id": "choose_gift_label",
            "label": "Button label",
            "default": "Choose Gift"
        },
        {
            "type": "url",
            "id": "choose_gift_link",
            "label": "Button link",
            "default": "/collections/all"
        },
        {
            "type": "header",
            "content": "Main Content"
        },
        {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background image - desktop",
            "info": "Upload a dbackground image for the hero banner."
        },
        {
            "type": "image_picker",
            "id": "mobile_background_image",
            "label": "Background image - mobile",
            "info": "Upload a background image for the hero banner on mobile devices."
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "The Gift Guide"
        },
        {
            "type": "richtext",
            "id": "description",
            "label": "Description - desktop",
            "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
        },
        {
            "type": "richtext",
            "id": "mobile_description",
            "label": "Description - mobile",
            "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>",
            "info": "Leave empty to reuse the desktop description"
        },
        {
            "type": "text",
            "id": "shop_now_label",
            "label": "Button label",
            "default": "Shop Now"
        },
        {
            "type": "url",
            "id": "shop_now_link",
            "label": "Button link",
            "default": "/collections/all"
        },
        {
            "type": "header",
            "content": "Bottom Bar"
        },
        {
            "type": "text",
            "id": "bottom_bar_text",
            "label": "Bottom bar message",
            "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
        }
    ],
    "presets": [
        {
            "name": "Hero Banner"
        }
    ]
  }
{% endschema %}
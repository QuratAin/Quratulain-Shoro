{{  'components/hero-banner.css' | asset_url | stylesheet_tag }}

<div class="gift-banner" id="GiftBanner-{{ section.id }}">
    <div class="gift-banner__topbar">
        <h1>{{ section.settings.heading }}</h1>
    </div>
</div>

{% schema %}
  {
    "name": "Hero Banner",
    "tag": "section",
    "class": "section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Custom Hero Banner"
        },
        {
            "type": "textarea",
            "id": "subheading",
            "label": "Subheading",
            "default": "This is a custom hero banner section."
        }
    ],
    "presets": [
        {
            "name": "Hero Banner"
        }
    ]
  }
{% endschema %}
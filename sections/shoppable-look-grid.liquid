{{ 'component-shoppable-look-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-shoppable-look-grid.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #ShopTheLook-{{ section.id }} {
    --slg-columns-mobile: {{ section.settings.columns_mobile }};
    --slg-columns-desktop: {{ section.settings.columns_desktop }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}


<div
  id="ShopTheLook-{{ section.id }}"
  class="shoppable-grid-section color-{{ section.settings.color_scheme }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="shoppable-grid-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="shoppable-grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        <div class="shoppable-tile" data-tile {{ block.shopify_attributes }}>
          {%- if product != blank -%}
            <div class="shoppable-tile__media">
              {%- if block.settings.image -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 400 }} 400w,
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(min-width: 750px) 33vw, 50vw"
                  alt="{{ block.settings.image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="shoppable-tile__image"
                >
              {%- else -%}
                {{ product.featured_image | image_url: width: 800 | image_tag: class: 'shoppable-tile__image', sizes: '(min-width: 750px) 33vw, 50vw', alt: product.title }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop the look grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Automatic bundle add-on"
    },
    {
      "type": "paragraph",
      "content": "When a shopper adds a variant matching both trigger values below to their cart, the bundle product is added automatically alongside it."
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Bundle product to auto-add"
    },
    {
      "type": "text",
      "id": "bundle_trigger_value_1",
      "label": "Trigger option value 1",
      "default": "Black"
    },
    {
      "type": "text",
      "id": "bundle_trigger_value_2",
      "label": "Trigger option value 2",
      "default": "Medium"
    },
    {
      "type": "text",
      "id": "bundle_message",
      "label": "Confirmation message when bundle is added",
      "default": "Added to cart — your bundle item was included."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Product tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image",
          "info": "Leave empty to use the product's own image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
